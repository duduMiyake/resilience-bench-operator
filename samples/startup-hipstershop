#!/usr/bin/env bash
set -euo pipefail

# Script de apoio para rodar o Hipster Shop.
#
# Modos comuns:
# - local com kind: use `start` para criar cluster, buildar imagem e aplicar tudo.
# - servidor/Vagrant/kubeadm: entre na VM controlplane, garanta que kubectl funciona
#   e use `deploy`, `restart-benchmark` ou `status`.
#
# Uso:
#   ./samples/startup-hipstershop start              # cria cluster kind, builda imagem, aplica CRDs e deploya tudo
#   ./samples/startup-hipstershop deploy             # aplica CRDs e overlay no cluster kubectl atual
#   ./samples/startup-hipstershop restart-benchmark  # limpa somente execucoes e reaplica o Benchmark
#   ./samples/startup-hipstershop status             # mostra nodes, pods e filas

CLUSTER_NAME="${CLUSTER_NAME:-resiliencebench}"
NAMESPACE="${NAMESPACE:-hipstershop}"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

kind_cluster_exists() {
  command_exists kind && kind get clusters 2>/dev/null | grep -qx "${CLUSTER_NAME}"
}

use_context_if_exists() {
  if kind_cluster_exists; then
    kubectl config use-context "kind-${CLUSTER_NAME}" >/dev/null
  fi
}

ensure_kubectl_access() {
  use_context_if_exists
  kubectl get nodes >/dev/null
}

ensure_kind_cluster() {
  if ! command_exists kind; then
    echo "kind nao esta instalado. Use 'deploy' em um cluster kubectl ja configurado."
    exit 1
  fi

  mkdir -p "${ROOT_DIR}/test-results"

  if kind_cluster_exists; then
    echo "Cluster kind '${CLUSTER_NAME}' ja existe."
  else
    echo "Criando cluster kind '${CLUSTER_NAME}' com worker app e worker infra..."
    kind create cluster --name "${CLUSTER_NAME}" --config "${ROOT_DIR}/kind-local-config.yaml"
  fi

  kubectl config use-context "kind-${CLUSTER_NAME}" >/dev/null
}

build_and_load_operator() {
  echo "Buildando imagem local do resiliencebench-operator..."
  (cd "${ROOT_DIR}/resilience-bench" && \
    mvn com.google.cloud.tools:jib-maven-plugin:3.4.2:dockerBuild -B \
      -f operator/pom.xml \
      -Djib.to.image=resiliencebench-operator:local)

  echo "Carregando imagem local no kind..."
  kind load docker-image resiliencebench-operator:local --name "${CLUSTER_NAME}"
}

deploy_hipstershop() {
  ensure_kubectl_access

  echo "Aplicando CRDs..."
  kubectl apply -f "${ROOT_DIR}/crd"

  echo "Aplicando overlay Hipster Shop..."
  kubectl apply -k "${ROOT_DIR}/samples/overlays/hipstershop"

  echo "Aguardando Deployments do namespace ${NAMESPACE}..."
  kubectl get deployment -n "${NAMESPACE}" -o name | while read -r deployment; do
    kubectl rollout status "${deployment}" -n "${NAMESPACE}" --timeout=5m
  done
}

restart_benchmark() {
  ensure_kubectl_access

  echo "Limpando somente recursos de execucao do benchmark..."
  kubectl delete benchmark hipstershop -n "${NAMESPACE}" --ignore-not-found=true
  kubectl delete scenario --all -n "${NAMESPACE}" --ignore-not-found=true
  kubectl delete queue --all -n "${NAMESPACE}" --ignore-not-found=true
  kubectl delete job --all -n "${NAMESPACE}" --ignore-not-found=true

  echo "Reaplicando Benchmark e recursos declarativos do overlay..."
  kubectl apply -k "${ROOT_DIR}/samples/overlays/hipstershop"
}

status() {
  ensure_kubectl_access

  echo
  echo "Nodes e labels:"
  kubectl get nodes --show-labels

  echo
  echo "Pods do Hipster Shop por node:"
  kubectl get pods -n "${NAMESPACE}" -o wide

  echo
  echo "Benchmarks, queues e jobs:"
  kubectl get benchmark,queue,scenario,job -n "${NAMESPACE}" || true
}

case "${1:-help}" in
  start)
    ensure_kind_cluster
    build_and_load_operator
    deploy_hipstershop
    status
    ;;
  deploy)
    deploy_hipstershop
    status
    ;;
  restart-benchmark)
    restart_benchmark
    status
    ;;
  status)
    status
    ;;
  help|--help|-h)
    sed -n '1,18p' "$0"
    ;;
  *)
    echo "Comando desconhecido: $1"
    echo "Use: $0 start|deploy|restart-benchmark|status"
    exit 1
    ;;
esac
