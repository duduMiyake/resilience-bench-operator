+++ b/src/checkoutservice/svcconfig_test.go
@@ -0,0 +1,83 @@
+package main
+
+import (
+	"context"
+	"net"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	healthpb "google.golang.org/grpc/health/grpc_health_v1"
+	"google.golang.org/grpc/status"
+	"google.golang.org/grpc/test/bufconn"
+)
+
+type unavailableHealth struct {
+	healthpb.UnimplementedHealthServer
+	calls atomic.Int32
+}
+
+func (s *unavailableHealth) Check(context.Context, *healthpb.HealthCheckRequest) (*healthpb.HealthCheckResponse, error) {
+	s.calls.Add(1)
+	return nil, status.Error(codes.Unavailable, "test-only unavailability")
+}
+
+func TestDestinationPoliciesDoNotOverwriteOrInherit(t *testing.T) {
+	setPolicy := func(destination, attempts string) {
+		for name, value := range map[string]string{
+			"MAX_ATTEMPTS": attempts, "INITIAL_BACKOFF": "0.001s",
+			"MAX_BACKOFF": "0.001s", "BACKOFF_MULTIPLIER": "1",
+		} {
+			if attempts == "" {
+				value = ""
+			}
+			t.Setenv("GRPC_"+destination+"_"+name, value)
+		}
+	}
+	setPolicy("PAYMENT", "2")
+	setPolicy("SHIPPING", "5")
+	t.Setenv("GRPC_MAX_ATTEMPTS", "4")
+	assertAttempts := func(dest string, expected int32) {
+		t.Helper()
+		config, err := BuildServiceConfig(dest)
+		if err != nil {
+			t.Fatal(err)
+		}
+		listener := bufconn.Listen(1024 * 1024)
+		server := grpc.NewServer()
+		service := &unavailableHealth{}
+		healthpb.RegisterHealthServer(server, service)
+		go server.Serve(listener)
+		defer server.Stop()
+		var options = []grpc.DialOption{
+			grpc.WithContextDialer(func(context.Context, string) (net.Conn, error) { return listener.Dial() }),
+			grpc.WithTransportCredentials(insecure.NewCredentials()),
+		}
+		if config != "" {
+			options = append(options, grpc.WithDefaultServiceConfig(config))
+		}
+		conn, err := grpc.NewClient("passthrough:///test", options...)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer conn.Close()
+		ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+		defer cancel()
+		_, err = healthpb.NewHealthClient(conn).Check(ctx, &healthpb.HealthCheckRequest{})
+		if status.Code(err) != codes.Unavailable || service.calls.Load() != expected {
+			t.Fatalf("%s: got %d calls and %v, want %d calls and UNAVAILABLE", dest, service.calls.Load(), err, expected)
+		}
+	}
+	assertAttempts("PAYMENT", 2)
+	assertAttempts("SHIPPING", 5)
+	setPolicy("PAYMENT", "")
+	assertAttempts("PAYMENT", 1)
+	assertAttempts("SHIPPING", 5)
+	t.Setenv("GRPC_PAYMENT_MAX_ATTEMPTS", "2")
+	if _, err := BuildServiceConfig("PAYMENT"); err == nil {
+		t.Fatal("partial configuration was accepted")
+	}
+}
